# Script mode (-P). Inputs: SOURCE_DIR, OUTPUT_FILE, EXTRA_ARG (optional, e.g. "debug").
set(major 0) 
set(minor 0)
set(patch 0)
set(distance 0)
set(dirty 0)
set(meta "")
if(EXTRA_ARG)
  set(meta "${EXTRA_ARG}.")
endif()

find_program(GIT_EXE git)
set(have_git FALSE)
if(GIT_EXE)
  execute_process(COMMAND ${GIT_EXE} rev-parse --is-inside-work-tree
                  WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE inside
                  OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
  if(rc EQUAL 0 AND inside STREQUAL "true")
    set(have_git TRUE)
  endif()
endif()

if(have_git)
  execute_process(COMMAND ${GIT_EXE} diff --shortstat WORKING_DIRECTORY "${SOURCE_DIR}"
                  OUTPUT_VARIABLE diffstat OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(diffstat)
    set(dirty 1)
  endif()
  execute_process(COMMAND ${GIT_EXE} describe --tags --match "v[0-9]*.[0-9]*.[0-9]*" --abbrev=0
                  WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE tag
                  OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
  if(rc EQUAL 0 AND tag MATCHES "^v([0-9]+)\\.([0-9]+)\\.([0-9]+)")
    set(major ${CMAKE_MATCH_1}) 
    set(minor ${CMAKE_MATCH_2})
    set(patch ${CMAKE_MATCH_3})
    set(range "${tag}..HEAD")
  else()
    set(range "HEAD")
  endif()
  execute_process(COMMAND ${GIT_EXE} rev-list --count ${range}
                  WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE distance
                  OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(distance STREQUAL "")
    set(distance 0)
    set(meta "unknown.${meta}")
  endif()
  if("${distance}${dirty}" STREQUAL "00")
    set(version_string "${major}.${minor}.${patch}")
  else()
    execute_process(COMMAND ${GIT_EXE} describe --abbrev=8 --always
                    WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE desc
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    math(EXPR patch_plus_one "${patch} + 1")
    set(version_string "${major}.${minor}.${patch_plus_one}-dev.${distance}.${dirty}")
    if(dirty)
      set(meta "${desc}.dirty.${meta}")
    else()
      set(meta "${desc}.${meta}")
    endif()
  endif()
else()
  message(STATUS "Not a Git checkout (or git missing): using version 0.0.0+unknown")
  set(version_string "0.0.0")
  set(meta "unknown.${meta}")
endif()

# Explicit override (-DXIDI_VERSION=x.y.z): wins over anything derived from Git
if(VERSION_OVERRIDE)
  if(VERSION_OVERRIDE MATCHES "^([0-9]+)\\.([0-9]+)\\.([0-9]+)$")
    set(major ${CMAKE_MATCH_1})
    set(minor ${CMAKE_MATCH_2})
    set(patch ${CMAKE_MATCH_3})
    set(distance 0)
    set(dirty 0)
    set(meta "")
    set(version_string "${major}.${minor}.${patch}")
  else()
    message(FATAL_ERROR "XIDI_VERSION must look like 1.2.3 (got '${VERSION_OVERRIDE}')")
  endif()
endif()

if(meta)
  string(REGEX REPLACE "\\.$" "" meta_trimmed "${meta}")
  set(version_string "${version_string}+${meta_trimmed}")
endif()
math(EXPR flags "${distance} * 16 + ${dirty}")

set(content "// Git version information
// Auto-generated by GitVersionInfoGenerate.cmake
#define GIT_VERSION_MAJOR ${major}
#define GIT_VERSION_MINOR ${minor}
#define GIT_VERSION_PATCH ${patch}
#define GIT_VERSION_FLAGS ${flags}
#define GIT_VERSION_COMMIT_DISTANCE ${distance}
#define GIT_VERSION_IS_DIRTY ${dirty}
#define GIT_VERSION_STRUCT ${major},${minor},${patch},${flags}
#define GIT_VERSION_STRING \"${version_string}\"
")
# Only rewrite when changed, to avoid needless rebuilds
set(old "")
if(EXISTS "${OUTPUT_FILE}")
  file(READ "${OUTPUT_FILE}" old)
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUTPUT_FILE}" "${content}")
endif()
